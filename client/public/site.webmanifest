{
  "id": "/",
  "name": "四色牌",
  "short_name": "四色牌",
  "description": "适合四人同玩的在线四色牌游戏",
  "lang": "zh-CN",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "related_applications": [
    {
      "platform": "webapp",
      "url": "/site.webmanifest",
      "id": "/"
    }
  ],
  "background_color": "#020617",
  "theme_color": "#0b1220",
  "icons": [
    {
      "src": "/icons/sise-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/sise-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/sise-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
