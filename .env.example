# Image and package mirrors.
NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
REDIS_IMAGE=docker.m.daocloud.io/library/redis:7-alpine
NPM_CONFIG_REGISTRY=https://registry.npmjs.org

# Frontend backend endpoints.
# Leave empty for local npm dev or standalone Docker on the same host.
# For Traefik/HTTPS deployment, set these to the public backend origin.
# Examples:
# VITE_SERVER_URL=wss://api.example.com
# VITE_SERVER_HTTP_URL=https://api.example.com
VITE_SERVER_URL=
VITE_SERVER_HTTP_URL=

# Server runtime settings.
# Leave empty for the standard localhost Compose defaults. Set the exact public
# web origin for LAN hostnames and every production deployment.
CORS_ALLOWED_ORIGINS=
# The Colyseus monitor is for trusted local diagnostics only.
ENABLE_MONITOR=0
# Keep 0 for direct access. Traefik Compose defaults this to one trusted hop so
# per-IP limits use the real browser address instead of the proxy container.
TRUST_PROXY_HOPS=0
# Conservative per-client HTTP budgets. Values apply within the shared window.
HTTP_RATE_LIMIT_WINDOW_MS=60000
ROOM_CREATE_RATE_LIMIT=10
PRIVATE_STATE_RATE_LIMIT=180
REDIS_URL=redis://redis:6379
MIN_PLAYERS=1
OP_TIMEOUT_MS=30000
DECLARE_TIMEOUT_MS=45000
TIME_EXTENSION_MS=20000
RECONNECT_GRACE_MS=5000
BOT_THINK_MIN_MS=450
BOT_THINK_MAX_MS=850
BOT_COLLECTIVE_THINK_MIN_MS=80
BOT_COLLECTIVE_THINK_MAX_MS=180
LOCAL_TRANSITION_DELAY_MS=250
ROOM_LOG=1
HU_LOG=1
ROOM_STATE_LOG_MODE=compact
# Test-only state injection. Production ignores this even when set to 1.
ENABLE_DEBUG_SCENARIOS=0

# Traefik deployment.
# Only used by docker-compose.traefik.yml.
TRAEFIK_NETWORK=traefik-global-proxy
TRAEFIK_CERT_RESOLVER=tencentcloud
TRAEFIK_WEB_ROUTER=sise-web
TRAEFIK_SERVER_ROUTER=sise-server
# Values must be valid Traefik rules.
# TRAEFIK_WEB_RULE=Host(`sise.example.com`)
# TRAEFIK_SERVER_RULE=Host(`sise-api.example.com`)
