# Optional frontend backend endpoints.
# Leave empty to use the default browser-side fallback:
#   ws(s)://<当前前端主机>:2567
#   http(s)://<当前前端主机>:2567
#
# Examples:
# VITE_SERVER_URL=ws://localhost:2567
# VITE_SERVER_HTTP_URL=http://localhost:2567
# VITE_SERVER_URL=wss://api.example.com
# VITE_SERVER_HTTP_URL=https://api.example.com
VITE_SERVER_URL=
VITE_SERVER_HTTP_URL=

REDIS_URL=redis://redis:6379
BOT_THINK_MIN_MS=1800
BOT_THINK_MAX_MS=3200
LOCAL_TRANSITION_DELAY_MS=5000
