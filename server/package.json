{
  "name": "four-color-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "npm run build && node dist/tests/run.js && node --test dist/tests/http/*.test.js dist/tests/rules/*.test.js dist/tests/rooms/*.test.js"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.10",
    "@colyseus/monitor": "^0.18.3",
    "@colyseus/schema": "^5.0.27",
    "@colyseus/ws-transport": "^0.18.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
